{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "ignoreDeprecations": "6.0",
    "outDir": "./ts-dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/shared/types/**/*.ts", "src/shared/utils/**/*.ts", "src/shared/constants/**/*.ts"]
}