{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist/electron",
    "rootDir": "./src/electron",
    "moduleResolution": "node"
  },
  "include": ["src/electron/**/*"],
  "exclude": ["node_modules"]
}