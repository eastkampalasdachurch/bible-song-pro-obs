{
  "name": "sda-bible-song-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "powershell -File scripts/build-electron.ps1 -dev",
    "electron:build": "powershell -File scripts/build-electron.ps1",
    "electron:start": "npx electron ."
  },
  "build": {
    "appId": "com.eastkampalasdachurch.sda-bible-song-pro",
    "productName": "SDA Bible Song Pro",
    "files": [
      "src/electron/**/*",
      "src/server/**/*",
      ".next/static/**/*",
      ".next/server/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": ".next/server/app.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^31.7.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5"
  }
}
